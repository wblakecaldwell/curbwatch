# Copy to ~/.config/nestmon/.env and fill in. It lives outside the repo on purpose.
#
# On macOS you can leave a key blank here and store it in the Keychain instead:
#   security add-generic-password -a "$USER" -s nestmon-starling -w
#   security add-generic-password -a "$USER" -s nestmon-anthropic -w   (only if VISION_BACKEND=api)

# --- Starling Home Hub (required) ---
# IP address or hostname of your hub on the LAN.
STARLING_HUB=192.168.1.50
# Developer Connect API key, from the Starling Home Hub app.
STARLING_API_KEY=
# Ports, if you changed them on the hub.
# STARLING_HTTPS_PORT=3443
# STARLING_HTTP_PORT=3080

# --- Scene descriptions (nestmon snap --describe, nestmon ask) ---
# api = Anthropic API (needs ANTHROPIC_API_KEY); agy = Antigravity CLI
VISION_BACKEND=api
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# AGY_MODEL=claude-opus-5-5-low
# AGY_BIN=/path/to/agy

# --- Garbage-can check (nestmon cans ...) ---
# Local vision model: lmstudio (default) or ollama. The model is unloaded after each check.
LOCAL_BACKEND=lmstudio
LMSTUDIO_URL=http://localhost:1234
# Only if LM Studio's server requires authentication (or use the Keychain:
#   security add-generic-password -a "$USER" -s nestmon-lmstudio -w)
LM_API_TOKEN=
LOCAL_VISION_MODEL=qwen3-vl-30b-a3b-instruct-mlx
# For Ollama instead:
# LOCAL_BACKEND=ollama
# OLLAMA_URL=http://localhost:11434
# LOCAL_VISION_MODEL=qwen2.5vl:7b
# Tuning; calibrate against your own ~/.local/share/nestmon/curb/history/log.jsonl.
# NIGHT_VISIBLE_CUTOFF=0.6
# MIN_INLIERS=25
# MAX_SHIFT_FRAC=0.15

# --- Storage (both hold pictures of your property; keep them outside the repo) ---
# NESTMON_DATA_DIR=~/.local/share/nestmon/snapshots
# NESTMON_STATE_DIR=~/.local/share/nestmon/curb
# off = night checks report "can't tell" (use when the curb is beyond the IR light)
NIGHT_CHECKS=on
